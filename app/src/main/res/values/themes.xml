<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NoContact" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.NoContact.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090909</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NoContact</item>
    </style>
</resources>
